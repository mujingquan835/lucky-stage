# 本地首次 npm start 会自动生成 .env 与随机管理员密码。
# 云端请自行填入以下值。密码请使用随机十六进制，避免数据库 URL 特殊字符问题。
ADMIN_USER=admin
ADMIN_PASSWORD=
POSTGRES_PASSWORD=
APP_DOMAIN=lottery.example.com
APP_ORIGIN=https://lottery.example.com
PORT=3000
# 独立运行时可填 PostgreSQL 连接；compose 自动注入。
# DATABASE_URL=postgres://lottery:密码@localhost:5432/lottery
